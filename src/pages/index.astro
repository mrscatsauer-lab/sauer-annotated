---
import Base from '../layouts/Base.astro';
import Crow from '../components/Crow.astro';
import PostCard from '../components/PostCard.astro';
import { SHELVES, SITE_TAGLINE } from '../consts';
import { getPosts } from '../utils';

const posts = await getPosts();
const latest = posts.slice(0, 6);
const counts = Object.fromEntries(
  Object.keys(SHELVES).map((k) => [k, posts.filter((p) => p.data.shelf === k).length]),
);
const shelfIcons: Record<string, string> = {
  reviews: 'M6 4h9a3 3 0 0 1 3 3v13H9a3 3 0 0 1-3-3V4Zm0 13a3 3 0 0 1 3-3h9',
  essays: 'M5 19 15 9m-4-4 4-1 5 5-1 4-8 8H5v-6l6-6Z',
  poems: 'M12 20c-4-3-8-6-8-10a4 4 0 0 1 8-1 4 4 0 0 1 8 1c0 4-4 7-8 10Z',
  'writing-life': 'M4 6h16M4 12h10M4 18h7m9-4-4 4-2-2',
  classroom: 'M4 9l8-4 8 4-8 4-8-4Zm3 2v5c3 2 7 2 10 0v-5',
};
---
<Base>
  <section class="hero">
    <div class="wrap grid">
      <div class="copy">
        <p class="hand kicker">pull up a chair</p>
        <h1>Margin notes on books, writing, and <em>everything else.</em></h1>
        <p class="lede">
          Reviews that actually say something, essays that wander on purpose, and the occasional poem.
          Written by an English teacher who cannot read a book without a pen in her hand.
        </p>
        <div class="actions">
          <a class="btn" href="#latest">Start reading</a>
          <a class="btn ghost" href="/about/">Meet the annotator</a>
        </div>
      </div>
      <div class="plate" aria-hidden="true">
        <div class="ruled">
          <span class="hand note n1">ah, the key to the stacks</span>
          <span class="hand note n2">note to self: more pens</span>
          <Crow size={260} class="hero-crow" />
          <p class="catalog">
            <span>Call No. 811.6 SAU</span>
            <span>Est. 2026</span>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap section" id="latest">
    <div class="section-head">
      <div>
        <p class="eyebrow">Fresh off the cart</p>
        <h2>Recently shelved</h2>
      </div>
      <a href="/archive/" class="see-all">See the whole archive →</a>
    </div>
    {latest.length ? (
      <div class="cards">{latest.map((post) => <PostCard post={post} />)}</div>
    ) : (
      <p class="empty hand">Nothing shelved yet. The first post is coming.</p>
    )}
  </section>

  <section class="wrap section">
    <div class="section-head">
      <div>
        <p class="eyebrow">Browse by section</p>
        <h2>The shelves</h2>
      </div>
    </div>
    <ul class="shelves">
      {Object.entries(SHELVES).map(([key, shelf]) => (
        <li class={`shelf-tile s-${key}`}>
          <a href={`/shelf/${key}/`}>
            <span class="disc">
              <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d={shelfIcons[key]} /></svg>
            </span>
            <span class="label">{shelf.label}</span>
            <span class="hand sub">{shelf.blurb}</span>
            <span class="count">{counts[key]} {counts[key] === 1 ? 'post' : 'posts'}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap section">
    <div class="quote">
      <p class="hand">a reminder, scribbled inside the front cover:</p>
      <blockquote>Read slowly. Argue with the author. Leave evidence that you were here.</blockquote>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: clamp(3rem, 8vw, 6rem) 0 clamp(2rem, 6vw, 4rem);
  }
  .grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .kicker {
    font-size: 1.9rem;
    margin: 0 0 0.25rem;
    transform: rotate(-2deg);
    transform-origin: left;
  }
  h1 {
    font-size: clamp(2.4rem, 5.2vw, 3.9rem);
    font-weight: 500;
    margin-bottom: 1.2rem;
  }
  h1 em {
    font-style: italic;
    color: var(--accent);
  }
  .lede {
    font-size: 1.2rem;
    color: var(--ink-soft);
    max-width: 34rem;
    margin: 0 0 2rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .plate {
    position: relative;
  }
  .plate::before {
    /* a book-spine stack peeking out behind the card */
    content: '';
    position: absolute;
    inset: 18px -14px -14px 18px;
    border-radius: var(--radius);
    background: repeating-linear-gradient(
      90deg,
      var(--oxblood) 0 22%,
      var(--green) 22% 40%,
      var(--rose) 40% 58%,
      var(--brass) 58% 74%,
      var(--green-soft) 74% 100%
    );
    opacity: 0.9;
  }
  .ruled {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 5 / 4;
    border-radius: var(--radius);
    border: 1px solid var(--rule);
    background:
      linear-gradient(90deg, transparent 2.6rem, var(--rose) 2.6rem, var(--rose) calc(2.6rem + 1px), transparent calc(2.6rem + 1px)),
      repeating-linear-gradient(var(--card) 0 31px, var(--rule) 31px 32px);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .ruled :global(.hero-crow) {
    color: var(--ink);
    width: 62%;
    height: auto;
    margin-top: 1rem;
  }
  .note {
    position: absolute;
    font-size: 1.35rem;
    line-height: 1;
  }
  .n1 {
    top: 12%;
    left: 16%;
    transform: rotate(-6deg);
  }
  .n2 {
    top: 9%;
    right: 8%;
    transform: rotate(5deg);
    color: var(--brass);
  }
  .catalog {
    position: absolute;
    bottom: 0.8rem;
    left: 3.4rem;
    right: 1.2rem;
    display: flex;
    justify-content: space-between;
    margin: 0;
    font-family: var(--font-ui);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .section {
    margin-top: clamp(3rem, 8vw, 5.5rem);
  }
  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 1rem;
    margin-bottom: 2rem;
  }
  .section-head h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.4rem);
    margin: 0.2rem 0 0;
  }
  .see-all {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 1.5rem;
  }
  .empty {
    font-size: 1.5rem;
  }

  .shelves {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.5rem;
  }
  .shelf-tile a {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-decoration: none;
    color: var(--ink);
  }
  .disc {
    display: grid;
    place-items: center;
    width: 110px;
    height: 110px;
    border-radius: 50%;
    background: var(--tint);
    color: var(--tone);
    margin-bottom: 0.9rem;
    transition: transform 0.2s ease;
  }
  .shelf-tile a:hover .disc {
    transform: rotate(-6deg) scale(1.05);
  }
  .label {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--tone);
  }
  .sub {
    font-size: 1.15rem;
    line-height: 1.15;
    color: var(--ink-soft);
    margin: 0.2rem 0 0.4rem;
  }
  .count {
    font-family: var(--font-ui);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .s-reviews { --tint: #f1d6d3; --tone: #6f1d24; }
  .s-essays { --tint: #cddbd8; --tone: #1f3b39; }
  .s-poems { --tint: #f6dfe3; --tone: #8e4f55; }
  .s-writing-life { --tint: #f8e6c3; --tone: #8a5f1c; }
  .s-classroom { --tint: #dbe5e3; --tone: #3e5f5b; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .shelf-tile { --tone: #f1e9dc; --tint: #26302e; }
  }
  :global(:root[data-theme='dark']) .shelf-tile { --tone: #f1e9dc; --tint: #26302e; }

  .quote {
    text-align: center;
    padding: clamp(2rem, 6vw, 3.5rem) 1rem;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .quote .hand {
    font-size: 1.4rem;
    margin: 0 0 0.6rem;
  }
  .quote blockquote {
    margin: 0 auto;
    max-width: 40rem;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-style: italic;
    line-height: 1.35;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .plate {
      max-width: 460px;
      margin-right: 14px;
    }
    .shelves {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 560px) {
    .n2 {
      display: none;
    }
    .shelves {
      grid-template-columns: repeat(2, 1fr);
    }
    .disc {
      width: 88px;
      height: 88px;
    }
  }
</style>

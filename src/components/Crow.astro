---
// The house crow: pen in beak, perched on the books.
// Your logo file lives at src/assets/crow-logo.webp. Swap that file to change it everywhere.
import { Image } from 'astro:assets';
import logo from '../assets/crow-logo.webp';
interface Props { size?: number; class?: string; badge?: boolean }
const { size = 56, class: className = '', badge = false } = Astro.props;
---
<span class:list={['crow', { badge }, className]} style={`--size:${size}px`}>
  <Image src={logo} alt="" width={size * 2} loading="eager" />
</span>
<style>
  .crow {
    display: inline-grid;
    place-items: center;
    width: var(--size);
    height: var(--size);
    flex-shrink: 0;
  }
  .crow img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  /* On dark backgrounds the black crow sits on a little paper medallion */
  .badge {
    border-radius: 50%;
    background: #f8f3ea;
    padding: calc(var(--size) * 0.12);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .crow:not(.badge) {
      border-radius: 50%;
      background: #f8f3ea;
      padding: calc(var(--size) * 0.1);
    }
  }
  :global(:root[data-theme='dark']) .crow:not(.badge) {
    border-radius: 50%;
    background: #f8f3ea;
    padding: calc(var(--size) * 0.1);
  }
</style>

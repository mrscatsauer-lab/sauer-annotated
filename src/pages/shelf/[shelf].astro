---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import PostCard from '../../components/PostCard.astro';
import Nightstand from '../../components/Nightstand.astro';
import { nightstand } from '../../data/nightstand';
import { Image } from 'astro:assets';
import shelfArt from '../../assets/art/bookshelf.webp';
import lateArt from '../../assets/art/sorry-im-late.webp';
import { SHELVES, SERIES, type ShelfKey } from '../../consts';
import { getPosts } from '../../utils';

export async function getStaticPaths() {
  const posts = await getPosts();
  return (Object.keys(SHELVES) as ShelfKey[]).map((shelf) => ({
    params: { shelf },
    props: { posts: posts.filter((p) => p.data.shelf === shelf) },
  }));
}
const { shelf } = Astro.params as { shelf: ShelfKey };
const { posts } = Astro.props;
const s = SHELVES[shelf];
const shelfSeries = Object.entries(SERIES).filter(([, v]) => v.shelf === shelf);
const classroom = posts.filter((p) => p.data.reviewSource !== 'nightstand');
const nightstandReviews = posts.filter((p) => p.data.reviewSource === 'nightstand');
---
<Base title={s.label} description={s.blurb}>
  <PageHead eyebrow="Shelf" title={s.label} note={s.blurb} />
  <div class="wrap">
    {shelf === 'parents' && (
      <a class="cards-callout" href="/cards/">
        <span class="hand">new!</span>
        <strong>Dinner Table Cards</strong>
        <span class="sub">Conversation starters by age. Shuffle one at the table or print the deck.</span>
        <span class="go">Open the deck →</span>
      </a>
    )}
    {shelf === 'teaching' && (
      <a class="cards-callout" href="/supply-closet/">
        <span class="hand">printables!</span>
        <strong>The Supply Closet</strong>
        <span class="sub">Every lesson and student handout on the site, ready to print or save as a PDF.</span>
        <span class="go">Grab what you need →</span>
      </a>
    )}
    {shelfSeries.length > 0 && (
      <nav class="series-row" aria-label="Series on this shelf">
        <p class="eyebrow">Regular features</p>
        <ul>
          {shelfSeries.map(([key, v]) => (
            <li>
              <a href={`/series/${key}/`} class:list={{ 'has-icon': 'icon' in v }}>
                {'icon' in v && <img class="icon" src={v.icon} alt={v.iconAlt} loading="lazy" />}
                <span class="text">
                  <span class="name">{v.label}</span>
                  <span class="blurb">{v.blurb}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
    {shelf === 'reviews' ? (
      <>
        <nav class="series-row" aria-label="Kinds of reviews">
          <p class="eyebrow">Two stacks</p>
          <ul>
            <li>
              <a href="#classroom" class="has-icon">
                <Image class="icon" src={shelfArt} alt="" width={180} />
                <span class="text">
                  <span class="name">From my classroom</span>
                  <span class="blurb">Books my students read with me, and what they really thought.</span>
                  <span class="count">{classroom.length} {classroom.length === 1 ? 'review' : 'reviews'} →</span>
                </span>
              </a>
            </li>
            <li>
              <a href="#nightstand" class="has-icon">
                <Image class="icon" src={lateArt} alt="" width={180} />
                <span class="text">
                  <span class="name">From my nightstand</span>
                  <span class="blurb">Books I read for me. No rubrics, just opinions.</span>
                  <span class="count">{nightstandReviews.length} {nightstandReviews.length === 1 ? 'review' : 'reviews'}{nightstand[0] ? ` + now reading: ${nightstand[0].title}` : ''} →</span>
                </span>
              </a>
            </li>
          </ul>
        </nav>
        <section class="review-group" id="classroom">
          <h2>From my classroom</h2>
          <p class="group-blurb">Books, stories, and plays my students read with me, plus what they really thought of them.</p>
          {classroom.length ? (
            <div class="cards">{classroom.map((p) => <PostCard post={p} />)}</div>
          ) : (
            <p class="hand empty">Nothing here yet.</p>
          )}
        </section>
        <section class="review-group" id="nightstand">
          <h2>From my nightstand</h2>
          <p class="group-blurb">Books I read for me. No lesson plans, no rubrics, just opinions.</p>
          <div class="ns-wrap"><Nightstand onShelf /></div>
          {nightstandReviews.length > 0 && (
            <div class="cards">{nightstandReviews.map((p) => <PostCard post={p} />)}</div>
          )}
        </section>
      </>
    ) : posts.length ? (
      <div class="cards">{posts.map((p) => <PostCard post={p} />)}</div>
    ) : (
      <p class="hand empty">This shelf is empty for now. Give it time.</p>
    )}
  </div>
</Base>
<style>
  .review-group {
    margin-bottom: 3.5rem;
    scroll-margin-top: 2rem;
  }
  .review-group h2 {
    font-size: 1.7rem;
    margin: 0 0 0.2rem;
  }
  .group-blurb {
    color: var(--ink-soft);
    margin: 0 0 1.5rem;
  }
  .ns-wrap {
    margin: 0.5rem 0 2rem;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 1.5rem;
  }
  .empty {
    font-size: 1.5rem;
  }
  .series-row {
    margin-bottom: 2.5rem;
  }
  .cards-callout {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.3rem 1rem;
    margin-bottom: 2rem;
    padding: 1.2rem 1.4rem;
    border-radius: var(--radius);
    border-top: 5px solid var(--accent);
    background: var(--card);
    box-shadow: var(--shadow);
    color: var(--ink);
    text-decoration: none;
  }
  .cards-callout .hand {
    font-size: 1.5rem;
    transform: rotate(-6deg);
    grid-row: span 2;
  }
  .cards-callout strong {
    font-family: var(--font-display);
    font-size: 1.35rem;
  }
  .cards-callout .sub {
    grid-column: 2;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  .cards-callout .go {
    grid-column: 3;
    grid-row: 1 / span 2;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }
  @media (max-width: 600px) {
    .cards-callout {
      grid-template-columns: 1fr;
    }
    .cards-callout .hand,
    .cards-callout .sub,
    .cards-callout .go {
      grid-column: 1;
      grid-row: auto;
    }
  }
  .series-row ul {
    list-style: none;
    padding: 0;
    margin: 0.6rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 1rem;
  }
  .series-row a {
    display: flex;
    gap: 1rem;
    align-items: center;
    height: 100%;
    padding: 0.85rem 1.1rem;
    border: 1.5px solid var(--accent);
    outline: 1px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
    background: var(--card);
    color: var(--ink);
    text-decoration: none;
    transition: transform 0.15s ease;
  }
  .series-row a:hover {
    transform: translateY(-2px);
  }
  .series-row .count {
    display: block;
    font-family: var(--font-hand);
    font-size: 1.2rem;
    color: var(--accent);
    margin-top: 0.3rem;
  }
  .series-row :global(.icon),
  .series-row .icon {
    width: 84px;
    height: auto;
    flex: none;
  }
  .series-row .name {
    display: block;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--accent);
  }
  .series-row .blurb {
    display: block;
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--ink-soft);
    margin-top: 0.15rem;
  }
  .series-row ul {
    gap: 1.2rem;
  }
</style>

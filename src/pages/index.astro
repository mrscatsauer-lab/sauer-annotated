---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import bouquet from '../assets/art/reading-bouquet.webp';
import bestBook from '../assets/art/best-book.webp';
import genreStack from '../assets/art/genre-stack.webp';
import loveBooks from '../assets/art/reading-is-my-love.webp';
import readMe from '../assets/art/read-me.webp';
import shelfArt from '../assets/art/bookshelf.webp';
import PostCard from '../components/PostCard.astro';
import { SHELVES, SITE_TAGLINE } from '../consts';
import { getPosts } from '../utils';

const posts = await getPosts();
const latest = posts.slice(0, 6);
const counts = Object.fromEntries(
  Object.keys(SHELVES).map((k) => [k, posts.filter((p) => p.data.shelf === k).length]),
);
const shelfArtwork = {
  reviews: bestBook,
  essays: genreStack,
  poems: loveBooks,
  'writing-life': readMe,
  classroom: shelfArt,
};
---
<Base>
  <section class="hero">
    <div class="wrap grid">
      <div class="copy">
        <p class="hand kicker">pull up a chair</p>
        <h1>Margin notes on books, writing, and <em class="underlined">everything else.</em></h1>
        <p class="lede">
          Reviews that actually say something, essays that wander on purpose, and the occasional poem.
          Written by an English teacher who cannot read a book without a pen in her hand.
        </p>
        <div class="actions">
          <a class="btn" href="#latest">Start reading</a>
          <a class="btn ghost" href="/about/">Meet the annotator</a>
        </div>
      </div>
      <div class="plate" aria-hidden="true">
        <span class="hand note n1">currently reading: everything</span>
        <Image src={bouquet} alt="" widths={[420, 640, 900]} sizes="(max-width: 900px) 90vw, 480px" loading="eager" class="bouquet" />
      </div>
    </div>
  </section>

  <section class="wrap section" id="latest">
    <div class="section-head">
      <div>
        <p class="eyebrow">Fresh off the cart</p>
        <h2>Recently shelved</h2>
      </div>
      <a href="/archive/" class="see-all">See the whole archive →</a>
    </div>
    {latest.length ? (
      <div class="cards">{latest.map((post) => <PostCard post={post} />)}</div>
    ) : (
      <p class="empty hand">Nothing shelved yet. The first post is coming.</p>
    )}
  </section>

  <section class="wrap section">
    <div class="section-head">
      <div>
        <p class="eyebrow">Browse by section</p>
        <h2>The shelves</h2>
      </div>
    </div>
    <ul class="shelves">
      {Object.entries(SHELVES).map(([key, shelf]) => (
        <li class={`shelf-tile s-${key}`}>
          <a href={`/shelf/${key}/`}>
            <span class="disc">
              <Image src={shelfArtwork[key as keyof typeof shelfArtwork]} alt="" width={180} class="disc-art" />
            </span>
            <span class="label">{shelf.label}</span>
            <span class="hand sub">{shelf.blurb}</span>
            <span class="count">{counts[key]} {counts[key] === 1 ? 'post' : 'posts'}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap section">
    <div class="quote">
      <span class="crosses" aria-hidden="true"></span>
      <p class="hand">a reminder, scribbled inside the front cover:</p>
      <blockquote>Read slowly. Argue with the author. Leave evidence that you were here.</blockquote>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: clamp(3rem, 8vw, 6rem) 0 clamp(2rem, 6vw, 4rem);
  }
  .grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .kicker {
    font-size: 1.9rem;
    margin: 0 0 0.25rem;
    transform: rotate(-2deg);
    transform-origin: left;
  }
  h1 {
    font-size: clamp(2.4rem, 5.2vw, 3.9rem);
    font-weight: 500;
    margin-bottom: 1.2rem;
  }
  h1 em {
    font-style: italic;
    color: var(--accent);
  }
  .lede {
    font-size: 1.2rem;
    color: var(--ink-soft);
    max-width: 34rem;
    margin: 0 0 2rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  h1 em.underlined {
    position: relative;
    z-index: 0;
    white-space: nowrap;
  }
  h1 em.underlined::after {
    content: '';
    position: absolute;
    z-index: -1;
    left: -2%;
    right: 2%;
    bottom: 0.02em;
    height: 0.32em;
    background: url('/art/scribble-mustard.webp') center / 100% 100% no-repeat;
    opacity: 0.75;
  }

  .plate {
    position: relative;
    display: grid;
    place-items: center;
  }
  .plate::before {
    /* sprinkle of terracotta crosses behind the art */
    content: '';
    position: absolute;
    inset: -6% 10% 0 -8%;
    background: url('/art/crosses.webp') center / contain no-repeat;
    opacity: 0.35;
  }
  .plate :global(.bouquet) {
    position: relative;
    width: 100%;
    max-width: 480px;
    height: auto;
  }
  .note {
    position: absolute;
    z-index: 1;
    top: -0.5rem;
    right: 0;
    font-size: 1.45rem;
    line-height: 1;
    transform: rotate(4deg);
    color: var(--accent);
  }

  .section {
    margin-top: clamp(3rem, 8vw, 5.5rem);
  }
  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 1rem;
    margin-bottom: 2rem;
  }
  .section-head h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.4rem);
    margin: 0.2rem 0 0;
  }
  .see-all {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 1.5rem;
  }
  .empty {
    font-size: 1.5rem;
  }

  .shelves {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.5rem;
  }
  .shelf-tile a {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-decoration: none;
    color: var(--ink);
  }
  .disc {
    display: grid;
    place-items: center;
    width: 132px;
    height: 132px;
    border-radius: 50%;
    background: var(--tint);
    margin-bottom: 0.9rem;
    transition: transform 0.2s ease;
  }
  .disc :global(.disc-art) {
    width: 76%;
    height: 76%;
    object-fit: contain;
  }
  .shelf-tile a:hover .disc {
    transform: rotate(-6deg) scale(1.05);
  }
  .label {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--tone);
  }
  .sub {
    font-size: 1.15rem;
    line-height: 1.15;
    color: var(--ink-soft);
    margin: 0.2rem 0 0.4rem;
  }
  .count {
    font-family: var(--font-ui);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .s-reviews { --tint: #f6e1d9; --tone: #a64b2f; }
  .s-essays { --tint: #d9e3dc; --tone: #1f4d46; }
  .s-poems { --tint: #f4dcd3; --tone: #a9573f; }
  .s-writing-life { --tint: #f8e7c2; --tone: #8a6312; }
  .s-classroom { --tint: #e3e8dc; --tone: #4f604c; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .shelf-tile { --tone: #f1e9dc; --tint: #263a36; }
  }
  :global(:root[data-theme='dark']) .shelf-tile { --tone: #f1e9dc; --tint: #263a36; }

  .quote {
    position: relative;
    text-align: center;
    padding: clamp(2rem, 6vw, 3.5rem) 1rem;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .crosses {
    position: absolute;
    left: 0;
    top: 50%;
    width: 110px;
    height: 130px;
    transform: translateY(-50%);
    background: url('/art/crosses.webp') center / contain no-repeat;
    opacity: 0.55;
  }
  .quote .hand {
    font-size: 1.4rem;
    margin: 0 0 0.6rem;
  }
  .quote blockquote {
    margin: 0 auto;
    max-width: 40rem;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-style: italic;
    line-height: 1.35;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .plate {
      max-width: 320px;
      margin: 0 auto;
    }
    .shelves {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 560px) {
    .shelves {
      grid-template-columns: repeat(2, 1fr);
    }
    .disc {
      width: 110px;
      height: 110px;
    }
    .crosses {
      display: none;
    }
    h1 em.underlined {
      white-space: normal;
    }
  }
</style>

---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { Image } from 'astro:assets';
import soMany from '../assets/art/so-many-books.webp';
---
<Base title="About" description="Who is doing all this annotating.">
  <PageHead eyebrow="About" title="Meet the annotator" note="hi, it's me" />
  <div class="wrap about">
    <div class="prose">
      <p>
        I'm Catherine Sauer: high school English teacher, reading specialist, doctoral candidate in literacy,
        and a person who has never once returned a book without leaving a little of herself in the margins.
      </p>
      <p>
        <em>Sauer, Annotated</em> is where those margin notes live now. Expect honest book reviews, essays
        that take the long way around, a poem when one shows up, and dispatches from the writing life.
      </p>
      <p>
        If you're here, you probably read with a pen too. Welcome. Pull up a chair.
      </p>
    </div>
    <div class="art-side" aria-hidden="true"><Image src={soMany} alt="" width={520} /></div>
  </div>
</Base>
<style>
  .about {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 3rem;
    align-items: start;
  }
  .about .prose {
    margin: 0;
  }
  .art-side :global(img) {
    width: 100%;
    height: auto;
    transform: rotate(2deg);
  }
  @media (max-width: 760px) {
    .about {
      grid-template-columns: 1fr;
    }
    .art-side {
      max-width: 260px;
      margin: 0 auto;
      order: -1;
    }
  }
</style>

---
interface Props { eyebrow?: string; title: string; note?: string }
const { eyebrow, title, note } = Astro.props;
---
<header class="page-head wrap">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1>{title}</h1>
  {note && <p class="hand note">{note}</p>}
  <slot />
</header>
<style>
  .page-head {
    padding-top: clamp(2.5rem, 7vw, 4.5rem);
    padding-bottom: 2rem;
  }
  h1 {
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    font-weight: 500;
    margin: 0.3rem 0 0.2rem;
  }
  .note {
    font-size: 1.5rem;
    margin: 0;
    transform: rotate(-1.5deg);
    transform-origin: left;
  }
</style>

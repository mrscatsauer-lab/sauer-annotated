---
import Crow from './Crow.astro';
import { SITE_TITLE, SITE_TAGLINE } from '../consts';
const path = Astro.url.pathname;
// Plain-English menu so first-time readers know where to go.
// The clever shelf names still appear on the pages themselves.
const nav = [
  { href: '/shelf/writing-life/', label: 'Stories & Poems' },
  { href: '/shelf/essays/', label: 'Essays' },
  { href: '/shelf/reviews/', label: 'Reviews' },
  { href: '/shelf/teaching/', label: 'Teachers' },
  { href: '/shelf/parents/', label: 'Parents' },
  { href: '/about/', label: 'About' },
];
---
<div class="topbar">
  <div class="wrap">{SITE_TAGLINE}</div>
</div>
<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="brand" aria-label={`${SITE_TITLE}, home`}>
      <Crow size={92} class="brand-crow" />
      <span class="wordmark">Sauer<span class="comma">,</span> <span class="scrawl">annotated</span></span>
    </a>
    <div class="tools">
      <button class="theme" type="button" aria-label="Toggle dark mode" title="Lights on / lights off">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-4 10.5c.8.8 1 1.5 1 2.5h6c0-1 .2-1.7 1-2.5A6 6 0 0 0 12 3Z"/></svg>
      </button>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mainnav">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <span>Menu</span>
      </button>
    </div>
  </div>
  <nav class="mainnav" id="mainnav" aria-label="Main">
    <ul class="wrap">
      {nav.map((item) => (
        <li>
          <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const menuBtn = document.querySelector('.menu-btn');
  const mainnav = document.getElementById('mainnav');
  menuBtn?.addEventListener('click', () => {
    const open = mainnav?.classList.toggle('open') ?? false;
    menuBtn.setAttribute('aria-expanded', String(open));
  });
  const btn = document.querySelector('.theme');
  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    const dark =
      root.dataset.theme === 'dark' ||
      (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
    root.dataset.theme = dark ? 'light' : 'dark';
    try { localStorage.setItem('theme', root.dataset.theme); } catch {}
  });
</script>

<style>
  .topbar {
    background: var(--green);
    color: #e9e1d2;
    font-family: var(--font-ui);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-align: center;
    padding: 0.55rem 0;
  }
  .site-header {
    border-bottom: 1px solid var(--rule);
    background: var(--paper);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.9rem;
    padding-bottom: 0.9rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    text-decoration: none;
    color: var(--ink);
  }
  .wordmark {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .scrawl {
    display: inline-block;
    font-family: var(--font-hand);
    font-weight: 600;
    font-size: 1.45em;
    line-height: 0;
    color: var(--accent);
    letter-spacing: 0;
    transform: rotate(-4deg) translateY(0.04em);
    margin-left: 0.05em;
  }
  .comma {
    color: var(--accent);
  }
  .tools {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .mainnav {
    border-top: 1px solid var(--rule);
  }
  .mainnav ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.2rem 2.2rem;
    list-style: none;
    margin: 0 auto;
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
  }
  .mainnav a {
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-soft);
    padding: 0.3rem 0;
    border-bottom: 2px solid transparent;
  }
  .mainnav a:hover,
  .mainnav a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }
  .theme,
  .menu-btn {
    display: grid;
    place-items: center;
    height: 36px;
    border-radius: 999px;
    border: 1px solid var(--rule);
    background: transparent;
    color: var(--ink-soft);
    cursor: pointer;
  }
  .theme {
    width: 36px;
  }
  .theme:hover,
  .menu-btn:hover {
    color: var(--brass);
    border-color: var(--brass);
  }
  .menu-btn {
    display: none;
    grid-auto-flow: column;
    gap: 0.4rem;
    padding: 0 0.9rem;
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  @media (max-width: 760px) {
    .bar {
      padding-top: 0.6rem;
      padding-bottom: 0.6rem;
    }
    .wordmark {
      font-size: 1.45rem;
    }
    .brand {
      gap: 0.6rem;
    }
    .brand :global(.brand-crow) {
      --size: 64px !important;
    }
    .menu-btn {
      display: grid;
    }
    .mainnav {
      display: none;
    }
    .mainnav.open {
      display: block;
    }
    .mainnav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding-top: 0.25rem;
      padding-bottom: 0.5rem;
    }
    .mainnav li + li {
      border-top: 1px dashed var(--rule);
    }
    .mainnav a {
      display: block;
      padding: 0.85rem 0;
      font-size: 0.85rem;
      border-bottom: 0;
    }
    .mainnav a[aria-current='page'] {
      color: var(--accent);
    }
  }
  @media (max-width: 400px) {
    .wordmark {
      font-size: 1.25rem;
    }
    .brand :global(.brand-crow) {
      --size: 52px !important;
    }
    .menu-btn span {
      display: none;
    }
  }
</style>

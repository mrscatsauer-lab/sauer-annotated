---
import { getEntry, type CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import Crow from '../components/Crow.astro';
import { SHELVES, SERIES } from '../consts';
import { formatDate, readingTime } from '../utils';

interface Props { post: CollectionEntry<'posts'> }
const { post } = Astro.props;
const { title, description, date, updated, shelf, tags, book } = post.data;
const companion = post.data.companion ? await getEntry('posts', post.data.companion) : undefined;
const hasHiddenNotes = post.data.hiddenNotes && (post.body ?? '').includes('class="note');
const printUrl = new URL(Astro.url.pathname, Astro.site).toString().replace(/^https?:\/\//, '');
const stars = book?.rating !== undefined ? Math.round(book.rating * 2) / 2 : undefined;
---
<Base title={title} description={description}>
  <article class="post">
    <header class="post-head wrap">
      <p class="print-source">From <strong>Catherine, Annotated</strong> · {printUrl}</p>
      <p class="eyebrow">
        <a href={`/shelf/${shelf}/`}>{SHELVES[shelf].label}</a>
        <span aria-hidden="true">·</span>
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime(post.body)} min read</span>
      </p>
      {post.data.series && (
        <a class="series hand" href={`/series/${post.data.series}/`}>a {SERIES[post.data.series].label} post</a>
      )}
      <h1>{title}</h1>
      <p class="dek">{description}</p>
      {shelf === 'teaching' && (
        <p class="print-row">
          <button type="button" class="btn print-btn" data-print>Print this lesson</button>
          <span class="hand">or save it as a PDF</span>
        </p>
      )}
      {post.data.draft && <p class="draft">Draft: only visible while you preview locally</p>}
    </header>

    {book && (
      <aside class="catalog-card wrap" aria-label="Book details">
        <div class="card-inner">
          <p class="eyebrow">Catalog card</p>
          <p class="book-title">{book.title}</p>
          <p class="book-author">{book.author}</p>
          {stars !== undefined && (
            <p class="stars" aria-label={`${stars} out of 5`}>
              {[1, 2, 3, 4, 5].map((n) => (
                <span class={stars >= n ? 'on' : stars >= n - 0.5 ? 'half' : ''}>★</span>
              ))}
            </p>
          )}
        </div>
      </aside>
    )}

    {hasHiddenNotes && (
      <p class="edition-banner wrap" hidden>
        <span class="hand">you're reading the annotated edition</span>
        <button type="button" class="linkish" data-toggle-notes>back to the clean copy</button>
      </p>
    )}

    <div class:list={['prose', 'wrap-prose', { 'notes-hidden': hasHiddenNotes }]} id="story">
      <slot />
    </div>

    {hasHiddenNotes && (
      <aside class="reread wrap" aria-label="Annotated edition">
        <div class="reread-card">
          <p class="hand psst">psst.</p>
          <p class="reread-title">Read it again, annotated.</p>
          <p class="reread-sub">{post.data.annotationBlurb ?? 'See the clues I hid the first time, in my own margin notes.'}</p>
          <button type="button" class="btn" data-toggle-notes>Show my annotations</button>
        </div>
      </aside>
    )}

    {companion && (!companion.data.draft || import.meta.env.DEV) && (
      <aside class="companion wrap" aria-label="Companion piece">
        <a href={`/posts/${companion.id}/`}>
          <span class="hand">read it with its companion</span>
          <span class="c-title">{companion.data.title}</span>
          <span class="c-desc">{companion.data.description}</span>
        </a>
      </aside>
    )}

    <footer class="post-foot">
      {tags.length > 0 && (
        <ul class="tags" aria-label="Tags">
          {tags.map((t) => <li>#{t}</li>)}
        </ul>
      )}
      {updated && <p class="updated">Revised {formatDate(updated)}</p>}
      <div class="signoff">
        <Crow size={48} />
        <p class="hand">That's all from the margins. <a href="/archive/">Keep reading →</a></p>
      </div>
    </footer>
  </article>
</Base>

<script>
  document.querySelectorAll('[data-print]').forEach((btn) =>
    btn.addEventListener('click', () => window.print()),
  );
  const story = document.getElementById('story');
  const banner = document.querySelector('.edition-banner');
  const toggles = document.querySelectorAll('[data-toggle-notes]');
  if (story && toggles.length) {
    const label = document.querySelector('.reread .btn');
    toggles.forEach((btn) =>
      btn.addEventListener('click', () => {
        const showing = story.classList.toggle('notes-hidden') === false;
        story.classList.toggle('notes-revealed', showing);
        if (banner) banner.hidden = !showing;
        if (label) label.textContent = showing ? 'Hide my annotations' : 'Show my annotations';
        if (showing) {
          (banner ?? story).scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }),
    );
  }
</script>

<style>
  .print-source {
    display: none;
  }
  .print-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.4rem 1rem;
    margin-top: 1.4rem;
  }
  .print-row .hand {
    font-size: 1.35rem;
    color: var(--accent);
    transform: rotate(-3deg);
  }
  .edition-banner[hidden] {
    display: none;
  }
  .edition-banner {
    max-width: calc(var(--measure) + 2 * var(--gutter));
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin: 0 auto 1.5rem;
    padding-top: 0.6rem;
    padding-bottom: 0.6rem;
    border-top: 1px dashed var(--rose);
    border-bottom: 1px dashed var(--rose);
    scroll-margin-top: 1.5rem;
  }
  .edition-banner .hand {
    font-size: 1.4rem;
  }
  .linkish {
    background: none;
    border: 0;
    padding: 0;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .linkish:hover {
    color: var(--accent);
  }
  .reread {
    max-width: calc(30rem + 2 * var(--gutter));
    margin: 3rem auto 0;
  }
  .reread-card {
    position: relative;
    text-align: center;
    padding: 2rem 1.5rem 1.8rem;
    background: var(--card);
    border: 1px solid var(--rule);
    border-top: 5px solid var(--accent);
    border-radius: 6px 6px var(--radius) var(--radius);
    box-shadow: var(--shadow);
  }
  .psst {
    position: absolute;
    top: 0.6rem;
    left: 1rem;
    margin: 0;
    font-size: 1.5rem;
    transform: rotate(-8deg);
  }
  .reread-title {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 600;
    margin: 0 0 0.3rem;
  }
  .reread-sub {
    color: var(--ink-soft);
    font-size: 1rem;
    margin: 0 0 1.2rem;
  }
  .reread .btn {
    cursor: pointer;
  }
  .companion {
    max-width: calc(30rem + 2 * var(--gutter));
    margin: 2.5rem auto 0;
  }
  .companion a {
    display: block;
    text-align: center;
    padding: 1.2rem 1.4rem;
    border: 1px dashed var(--rose);
    border-radius: var(--radius);
    background: var(--rose-wash);
    color: var(--ink);
    text-decoration: none;
    transition: transform 0.15s ease;
  }
  .companion a:hover {
    transform: translateY(-2px);
    border-style: solid;
  }
  .companion .hand {
    display: block;
    font-size: 1.35rem;
    color: var(--accent);
  }
  .companion .c-title {
    display: block;
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 600;
    margin: 0.1rem 0 0.2rem;
  }
  .companion .c-desc {
    display: block;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }
  .post-head {
    max-width: calc(var(--measure) + 2 * var(--gutter));
    text-align: center;
    padding-top: clamp(2.5rem, 7vw, 5rem);
    padding-bottom: 2rem;
  }
  .post-head .eyebrow {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin: 0 0 1.2rem;
  }
  .post-head .eyebrow a {
    color: var(--accent);
    text-decoration: none;
  }
  .series {
    display: inline-block;
    font-size: 1.5rem;
    text-decoration: none;
    transform: rotate(-2deg);
    margin-bottom: 0.4rem;
  }
  .series:hover {
    text-decoration: underline;
  }
  h1 {
    font-size: clamp(2.2rem, 5.5vw, 3.6rem);
    font-weight: 500;
  }
  .dek {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.25rem;
    color: var(--ink-soft);
    margin: 0;
  }
  .draft {
    display: inline-block;
    margin-top: 1rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    background: var(--brass-wash);
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
  }
  .catalog-card {
    max-width: calc(26rem + 2 * var(--gutter));
    margin-bottom: 2.5rem;
  }
  .card-inner {
    background: var(--card);
    border: 1px solid var(--rule);
    border-radius: 6px;
    padding: 1.2rem 1.4rem;
    text-align: center;
    box-shadow: var(--shadow);
  }
  .card-inner .eyebrow {
    margin: 0 0 0.7rem;
    padding-bottom: 0.5rem;
    border-bottom: 1.5px solid var(--rose);
    color: var(--accent);
  }
  .book-title {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.35rem;
    margin: 0;
    line-height: 1.3;
  }
  .book-author {
    margin: 0;
    color: var(--ink-soft);
  }
  .stars {
    margin: 0.3rem 0 0;
    letter-spacing: 0.15em;
    color: var(--rule);
    font-size: 1.1rem;
  }
  .stars .on {
    color: var(--brass);
  }
  .stars .half {
    background: linear-gradient(90deg, var(--brass) 50%, var(--rule) 50%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .wrap-prose {
    padding: 0 var(--gutter);
  }
  .post-foot {
    max-width: calc(var(--measure) + 2 * var(--gutter));
    margin: 3rem auto 0;
    padding: 0 var(--gutter);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
  }
  .tags li {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    background: var(--rose-wash);
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
  }
  .updated {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    color: var(--ink-soft);
  }
  .signoff {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    border-top: 1px solid var(--rule);
    padding-top: 1.5rem;
  }
  .signoff p {
    font-size: 1.4rem;
    margin: 0;
  }
</style>

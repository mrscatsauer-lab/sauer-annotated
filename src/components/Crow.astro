---
// The house crow, carrying the key to the stacks.
// Uses currentColor, so set `color` on a parent to recolor it.
interface Props { size?: number; class?: string; title?: string }
const { size = 120, class: className = '', title } = Astro.props;
---
<svg
  class={className}
  width={size}
  height={size * 0.82}
  viewBox="0 0 120 98"
  role={title ? 'img' : 'presentation'}
  aria-hidden={title ? undefined : 'true'}
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  {title && <title>{title}</title>}
  <!-- body -->
  <path
    d="M36 33 C42 20 62 15 76 22 C86 27 94 33 117 40 L111 45 L119 50 L99 50 C95 59 84 66 68 66 C52 66 41 58 37 47 Z"
    fill="currentColor"
  />
  <!-- beak -->
  <path d="M38 32 L4 41 L38 46 Z" fill="currentColor" />
  <!-- eye -->
  <path d="M51 28 a5 5 0 0 0 9 2" stroke="var(--paper, #f8f3ea)" stroke-width="2.2" stroke-linecap="round" />
  <!-- wing lines -->
  <path d="M70 34 C80 33 90 38 98 45" stroke="var(--paper, #f8f3ea)" stroke-width="1.6" stroke-linecap="round" opacity="0.7" />
  <path d="M68 41 C78 41 86 45 92 50" stroke="var(--paper, #f8f3ea)" stroke-width="1.2" stroke-linecap="round" opacity="0.45" />
  <!-- legs -->
  <path d="M60 65 L57 86 M57 86 L50 90 M57 86 L58 92 M57 86 L63 89" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
  <path d="M74 64 L76 85 M76 85 L70 90 M76 85 L78 91 M76 85 L83 88" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
  <!-- string and key -->
  <path d="M20 42 C19 47 21 50 20 54" stroke="currentColor" stroke-width="1.2" />
  <circle cx="20" cy="58" r="4" stroke="currentColor" stroke-width="2" />
  <path d="M20 62 L20 78 M20 71 L25 71 M20 76 L24 76" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
  <!-- shadow scratches -->
  <path d="M44 94 h6 M54 95 h10 M68 93 h5 M78 95 h9 M90 93 h4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" opacity="0.35" />
</svg>

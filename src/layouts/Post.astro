---
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import Crow from '../components/Crow.astro';
import { SHELVES } from '../consts';
import { formatDate, readingTime } from '../utils';

interface Props { post: CollectionEntry<'posts'> }
const { post } = Astro.props;
const { title, description, date, updated, shelf, tags, book } = post.data;
const stars = book?.rating !== undefined ? Math.round(book.rating * 2) / 2 : undefined;
---
<Base title={title} description={description}>
  <article class="post">
    <header class="post-head wrap">
      <p class="eyebrow">
        <a href={`/shelf/${shelf}/`}>{SHELVES[shelf].label}</a>
        <span aria-hidden="true">·</span>
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime(post.body)} min read</span>
      </p>
      <h1>{title}</h1>
      <p class="dek">{description}</p>
      {post.data.draft && <p class="draft">Draft: only visible while you preview locally</p>}
    </header>

    {book && (
      <aside class="catalog-card wrap" aria-label="Book details">
        <div class="card-inner">
          <p class="eyebrow">Catalog card</p>
          <p class="book-title">{book.title}</p>
          <p class="book-author">{book.author}</p>
          {stars !== undefined && (
            <p class="stars" aria-label={`${stars} out of 5`}>
              {[1, 2, 3, 4, 5].map((n) => (
                <span class={stars >= n ? 'on' : stars >= n - 0.5 ? 'half' : ''}>★</span>
              ))}
            </p>
          )}
        </div>
      </aside>
    )}

    <div class="prose wrap-prose">
      <slot />
    </div>

    <footer class="post-foot">
      {tags.length > 0 && (
        <ul class="tags" aria-label="Tags">
          {tags.map((t) => <li>#{t}</li>)}
        </ul>
      )}
      {updated && <p class="updated">Revised {formatDate(updated)}</p>}
      <div class="signoff">
        <Crow size={48} />
        <p class="hand">That's all from the margins. <a href="/archive/">Keep reading →</a></p>
      </div>
    </footer>
  </article>
</Base>

<style>
  .post-head {
    max-width: calc(var(--measure) + 2 * var(--gutter));
    text-align: center;
    padding-top: clamp(2.5rem, 7vw, 5rem);
    padding-bottom: 2rem;
  }
  .post-head .eyebrow {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin: 0 0 1.2rem;
  }
  .post-head .eyebrow a {
    color: var(--accent);
    text-decoration: none;
  }
  h1 {
    font-size: clamp(2.2rem, 5.5vw, 3.6rem);
    font-weight: 500;
  }
  .dek {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.25rem;
    color: var(--ink-soft);
    margin: 0;
  }
  .draft {
    display: inline-block;
    margin-top: 1rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    background: var(--brass-wash);
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
  }
  .catalog-card {
    max-width: calc(26rem + 2 * var(--gutter));
    margin-bottom: 2.5rem;
  }
  .card-inner {
    background: var(--card);
    border: 1px solid var(--rule);
    border-radius: 6px;
    padding: 1.2rem 1.4rem;
    text-align: center;
    box-shadow: var(--shadow);
  }
  .card-inner .eyebrow {
    margin: 0 0 0.7rem;
    padding-bottom: 0.5rem;
    border-bottom: 1.5px solid var(--rose);
    color: var(--accent);
  }
  .book-title {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.35rem;
    margin: 0;
    line-height: 1.3;
  }
  .book-author {
    margin: 0;
    color: var(--ink-soft);
  }
  .stars {
    margin: 0.3rem 0 0;
    letter-spacing: 0.15em;
    color: var(--rule);
    font-size: 1.1rem;
  }
  .stars .on {
    color: var(--brass);
  }
  .stars .half {
    background: linear-gradient(90deg, var(--brass) 50%, var(--rule) 50%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .wrap-prose {
    padding: 0 var(--gutter);
  }
  .post-foot {
    max-width: calc(var(--measure) + 2 * var(--gutter));
    margin: 3rem auto 0;
    padding: 0 var(--gutter);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
  }
  .tags li {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    background: var(--rose-wash);
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
  }
  .updated {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    color: var(--ink-soft);
  }
  .signoff {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    border-top: 1px solid var(--rule);
    padding-top: 1.5rem;
  }
  .signoff p {
    font-size: 1.4rem;
    margin: 0;
  }
</style>

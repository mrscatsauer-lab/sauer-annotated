---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import getLost from '../assets/art/get-lost.webp';
---
<Base title="Not found">
  <section class="wrap lost">
    <Image src={getLost} alt="Get lost! Read a book." width={520} class="lost-art" />
    <h1>This page has been checked out.</h1>
    <p>It may be overdue, misshelved, or never existed. Try the <a href="/archive/">archive</a> or head <a href="/">home</a>.</p>
  </section>
</Base>
<style>
  .lost {
    text-align: center;
    padding-top: 3rem;
  }
  .lost :global(.lost-art) {
    width: min(260px, 70vw);
    height: auto;
  }
  .hand {
    font-size: 1.6rem;
    margin: 0.5rem 0;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 500;
  }
</style>

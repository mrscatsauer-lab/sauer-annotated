---
import Crow from './Crow.astro';
import { SITE_TITLE, AUTHOR } from '../consts';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap inner">
    <div class="sign">
      <Crow size={54} class="foot-crow" />
      <div>
        <p class="name">{SITE_TITLE}</p>
        <p class="hand small">written in the margins by {AUTHOR}</p>
      </div>
    </div>
    <ul class="links">
      <li><a href="/shelf/">Shelves</a></li>
      <li><a href="/archive/">Archive</a></li>
      <li><a href="/about/">About</a></li>
      <li><a href="/rss.xml">RSS</a></li>
    </ul>
  </div>
  <div class="wrap fine">© {year} {AUTHOR}. All rights reserved, all margins scribbled in.</div>
</footer>

<style>
  .site-footer {
    margin-top: 6rem;
    background: var(--oxblood-deep);
    color: #f1e6d8;
    padding: 2.5rem 0 1.5rem;
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .sign {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .sign :global(.foot-crow) {
    color: #f1e6d8;
    --paper: var(--oxblood-deep);
  }
  .name {
    font-family: var(--font-display);
    font-size: 1.3rem;
    margin: 0;
  }
  .small {
    margin: 0;
    font-size: 1.2rem;
    color: var(--rose);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .links a {
    color: #f1e6d8;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .links a:hover {
    color: var(--rose);
  }
  .fine {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid rgb(241 230 216 / 0.18);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: rgb(241 230 216 / 0.7);
  }
</style>
